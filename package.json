{
  "name": "condux-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "bash scripts/dev-up.sh",
    "dev:stack": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build",
    "dev:down": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml down",
    "dev:logs": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml logs -f",
    "dev:runner": "bash scripts/runner-dev.sh",
    "dev:smee": "bash scripts/smee.sh",
    "dev:web": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml stop web && cd web && NEXT_PUBLIC_CONDUX_API_URL=http://localhost:8080 NEXT_PUBLIC_CONDUX_INGEST_URL=http://localhost:9010 pnpm dev",
    "dev:landing": "cd landing && NEXT_PUBLIC_CONDUX_APP_URL=http://localhost:3000 pnpm dev --port 3002",
    "check:style": "bash scripts/check-style.sh",
    "check:docs": "python3 scripts/check-doc-refs.py",
    "check:sdk-chain": "python3 scripts/check-sdk-chain.py",
    "clean:docker": "docker builder prune -f && docker image prune -f",
    "gen:postman": "node scripts/gen-postman.mjs",
    "seed:demo": "bash scripts/seed-demo.sh"
  },
  "devDependencies": {
    "openapi-to-postmanv2": "6.3.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.0",
      "postcss": "^8.5.18",
      "nanoid": "^3.3.17"
    }
  }
}
