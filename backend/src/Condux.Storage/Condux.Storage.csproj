<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
    <!-- Standard resilience (retry + timeout + circuit breaker, Polly-based) for the ClickHouse
         HTTP client, wired via IHttpClientFactory — no hand-rolled retry. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!-- Size-bounded caches for the native pass's symbolizer answers (SymbolizerCaches). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Condux.Core/Condux.Core.csproj" />
  </ItemGroup>
</Project>
