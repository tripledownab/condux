<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Condux.Runner.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- What a customer deploys. It reaches the control plane over one authenticated outbound HTTPS
         connection and holds its own model and source-host credentials, so there is deliberately no
         Storage or Messaging reference here: a runner never opens a database or a broker connection, and
         a reference that let it would be the bug, not the missing feature. -->
    <ProjectReference Include="..\Condux.Agent\Condux.Agent.csproj" />
    <ProjectReference Include="..\Condux.Core\Condux.Core.csproj" />
    <ProjectReference Include="..\Condux.GitHub\Condux.GitHub.csproj" />
    <ProjectReference Include="..\Condux.Telemetry\Condux.Telemetry.csproj" />
  </ItemGroup>
</Project>
