<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every control-plane, relay and worker host the suite starts runs inside this one test process,
         and the GC let its heap grow far past what was live: with the heap hard capped well below that
         peak, every test still passed. ConserveMemory trades more frequent collections for a smaller heap,
         and at 9 it tries hardest, with no ceiling a future test could hit. It matters on CI, where this process shares one VM with every
         container the suite starts. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Pin past two vulnerable transitives that arrive with the SAML library and Testcontainers.
         System.Security.Cryptography.Xml <= 10.0.9 carries the XML-signature advisories GHSA-8q5v-6pqq-x66h,
         -cvvh-rhrc-wg4q, -g8r8-53c2-pm3f, -mmjf-rqrv-855v and -23rf-6693-g89p, patched in 10.0.10, and
         <= 10.0.12 carries GHSA-r955-8q5j-3h83, -7hqp-7c5m-4vq6 and -c399-9853-6jmj, patched in 10.0.13.
         SSH.NET <= 2025.1.0 is GHSA-q939-rpr3-3284, patched in 2026.0.0.
         The services themselves resolve the framework-provided assembly, not this package, so only the
         test projects need the pin. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="Confluent.Kafka" Version="2.5.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Condux.Core/Condux.Core.csproj" />
    <ProjectReference Include="../../src/Condux.Messaging/Condux.Messaging.csproj" />
    <ProjectReference Include="../../src/Condux.Notifications/Condux.Notifications.csproj" />
    <ProjectReference Include="../../src/Condux.Storage/Condux.Storage.csproj" />
    <ProjectReference Include="../../src/Condux.ControlPlane/Condux.ControlPlane.csproj" />
    <!-- The agent execution core: the sandbox tests drive it directly. A library with no entry point, so
         unlike the workers below it needs no alias. -->
    <ProjectReference Include="../../src/Condux.Agent/Condux.Agent.csproj" />
    <!-- The fix-verification watcher (VerificationWorker) lives here. Alias it (like the relay) so its
         global `Program` stays out of the way of the control-plane's Program used by WebApplicationFactory. -->
    <ProjectReference Include="../../src/Condux.Conductor/Condux.Conductor.csproj" Aliases="conductor" />
    <!-- The consumer's AutoFixDispatcher (#101) is exercised directly; its Program is internal so it
         does not collide with the control-plane's Program under WebApplicationFactory. -->
    <ProjectReference Include="../../src/Condux.Consumer/Condux.Consumer.csproj" Aliases="consumer" />
    <!-- Both the control-plane and the relay expose a global `Program`; alias the relay
         so tests can host each via WebApplicationFactory<Program> / <relay::Program>. -->
    <ProjectReference Include="../../src/Condux.Relay/Condux.Relay.csproj" Aliases="relay" />
    <!-- The symbolizer service the native pass calls, hosted in process by the native tests. Aliased like
         the relay, since its Program would otherwise clash with the control-plane's. -->
    <ProjectReference Include="../../src/Condux.Symbolizer/Condux.Symbolizer.csproj" Aliases="symbolizer" />
    <!-- The demo-seed tool is an Exe with its own global `Program`; alias it so it does not collide. -->
    <ProjectReference Include="../../tools/Condux.DemoSeed/Condux.DemoSeed.csproj" Aliases="demoseed" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../migrations/postgres/*.sql" LinkBase="migrations" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../migrations/clickhouse/*.sql" LinkBase="migrations-clickhouse" CopyToOutputDirectory="PreserveNewest" />
    <!-- Runs test collections in parallel. JSON takes no comments, so the reasoning lives here.
         It used to serialize them, because every class started its own containers and running 69 of
         those at once was not viable. Classes now share one Postgres server and take a database each
         (Fixtures/PostgresServer), so they are independent without being expensive. Parallel, the whole
         suite runs in 283s to 314s where serial it took 408s to 492s, both measured locally.
         The suite is worth parallelising because it waits rather than computes: the serial run used
         274s of CPU across 408s of wall clock.
         maxParallelThreads is 4 because that is the only degree measured. Higher was never tried, and
         these numbers come from an 8-core Mac rather than from a CI runner, whose core count nobody
         here has established. Both are worth measuring before treating 4 as the right answer. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- One ELF builder for the parser's unit tests and the upload endpoint's integration tests. -->
  <ItemGroup>
    <Compile Include="../Shared/ElfFiles.cs" Link="Shared/ElfFiles.cs" />
    <Compile Include="../Shared/MachOFiles.cs" Link="Shared/MachOFiles.cs" />
    <Compile Include="../Shared/SymbolizerBinary.cs" Link="Shared/SymbolizerBinary.cs" />
    <Compile Include="../Shared/LoopbackHttpReceiver.cs" Link="Shared/LoopbackHttpReceiver.cs" />
    <None Include="Golden/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The symbolizer's inline-chain fixture, linked rather than copied so there is one file. -->
    <None Include="../Condux.Symbolizer.Tests/Fixtures/cart.so" Link="Golden/cart.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
