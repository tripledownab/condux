# What belongs here: every value a staging deployment needs that a production one does not, plus the
# credentials staging must not share with production. Copy to .env.staging ON THE HOST, fill it in,
# and chmod 600. It is never committed and never synced by a deploy: changing it is a manual step by
# design, so remember that a new key here also has to be added on the host by hand.
#
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.staging.yml \
#     --profile dev-mail up -d --build
#
# GENERATE FRESH SECRETS. Never copy production's: a staging host is reached by more people, patched
# less often and restored from less carefully, so every credential it holds should be one that grants
# nothing anywhere else.

# ---------------------------------------------------------------------------------------------------
# The host this deployment answers to.
#
# WRITTEN ONCE. Everything below that needs the hostname interpolates this key, because a deployment
# whose dashboard URL and whose minted DSNs disagreed about the host would still start, still look
# healthy, and hand out DSNs that reach nothing.
# ---------------------------------------------------------------------------------------------------
CONDUX_STAGING_HOST=CHANGE_ME_the_name_on_the_certificate

# The address the edge binds, and the ports it is reached on.
#
# BIND AN ADDRESS, NEVER 0.0.0.0. On a shared host the bind address is the control that still holds
# inside the box, and it is the only one that does: a host firewall does NOT filter published
# container ports, because the container runtime writes its rules into the nat table ahead of the
# chain the firewall filters. An unset value here is worse than a wrong one, since it falls back to
# the production binding and publishes staging to the internet.
# LOOPBACK ON PURPOSE. Nothing serves port 80 on the staging edge: automatic redirects are off,
# because an automatic one would send a plain-HTTP caller to 443 rather than the port this edge is
# actually reached on. Compose cannot un-publish a port a layered file declares, so the binding has to
# exist; putting it on loopback stops it advertising something that answers nothing. Measured: a
# request to this port on the tailnet address returned no response at all.
EDGE_HTTP_BIND=127.0.0.1:CHANGE_ME_unused_port:80
EDGE_HTTPS_BIND=CHANGE_ME_address:CHANGE_ME_https_port:443
EDGE_HTTPS_UDP_BIND=CHANGE_ME_address:CHANGE_ME_https_port:443/udp
# SDKs reach the relay here. Production gives the relay its own hostname; one certificate means one
# name, so staging gives it its own port on the same name instead.
EDGE_INGEST_BIND=CHANGE_ME_address:CHANGE_ME_ingest_port:444

# Where the mail catcher's inbox is read. Same rule as the bindings above: name an address. Pick a
# port nothing else on the host has taken, which will not be the container's own 8025 if anything
# else on the host already runs a catcher.
MAILPIT_BIND=CHANGE_ME_address:CHANGE_ME_inbox_port:8025

# The dashboard's absolute URL: invite links, SSO redirect URIs, the weekly digest CTA, the source-map
# upload target, and the address the deploy health-gates through. Must be what a browser types.
CONDUX_APP_BASE_URL=https://${CONDUX_STAGING_HOST}:CHANGE_ME_https_port

# What every minted DSN points at. THE MOST IMPORTANT PAIR IN THIS FILE: leave these unset and the
# production overlay's defaults apply, so this deployment hands out DSNs naming the production relay
# and anything wired to staging reports into production under a release production never ran.
CONDUX_INGEST_SCHEME=https
CONDUX_INGEST_HOST=${CONDUX_STAGING_HOST}:CHANGE_ME_ingest_port

# The host directory the shared certificate is issued into. Mount the issuing directory, not a copy:
# see the comment on the mount in docker-compose.staging.yml for what a copy silently costs.
STAGING_TLS_DIR=CHANGE_ME_absolute_path_to_the_certificate_directory

# What ClickHouse may take on a host it shares. A size accepted by the container runtime, e.g. 1g.
CLICKHOUSE_MEMORY_LIMIT=CHANGE_ME_memory_ceiling

# ---------------------------------------------------------------------------------------------------
# Datastores. Fresh credentials, generated on the host.
# ---------------------------------------------------------------------------------------------------
POSTGRES_USER=condux
POSTGRES_PASSWORD=CHANGE_ME_generated_on_the_host
POSTGRES_DB=condux

CLICKHOUSE_USER=condux
CLICKHOUSE_PASSWORD=CHANGE_ME_generated_on_the_host
CLICKHOUSE_DB=condux

# ---------------------------------------------------------------------------------------------------
# Mail. The bundled catcher, enabled by --profile dev-mail, never a real relay: a staging stack that
# can reach a real mail server can mail a real person by accident, and the address it reaches for is
# whatever happens to be in its database.
# ---------------------------------------------------------------------------------------------------
CONDUX_SMTP_HOST=mailpit

# Who may open the platform admin console here.
CONDUX_PLATFORM_ADMIN_EMAILS=CHANGE_ME_your_email

# ---------------------------------------------------------------------------------------------------
# Present but empty ON PURPOSE.
#
# Compose sources a build secret from CONDUX_RELEASE_TOKEN and refuses to start if the key is missing
# entirely, so these must EXIST. Empty means the feature is off: the dashboard does not report its own
# errors, and the web build stamps source maps without uploading them.
# ---------------------------------------------------------------------------------------------------
CONDUX_WEB_DSN=
CONDUX_WEB_PUBLIC_DSN=
CONDUX_SELF_DSN=
CONDUX_RELEASE_TOKEN=

# ---------------------------------------------------------------------------------------------------
# Third-party integrations, deliberately OFF, and listed rather than omitted.
#
# Each route they gate 404s while unset, which is the posture staging wants: staging must not hold
# production's GitHub App key, OAuth client or payment credentials, and must not be able to act on a
# real customer's repository or charge a real card. Naming them keeps twenty routine "not set"
# warnings out of the deploy log, which is where a warning that matters would otherwise hide.
# ---------------------------------------------------------------------------------------------------
CONDUX_GITHUB_CLIENT_ID=
CONDUX_GITHUB_CLIENT_SECRET=
CONDUX_GITHUB_WEBHOOK_SECRET=
CONDUX_GITHUB_APP_SLUG=
CONDUX_GITHUB_OAUTH_REDIRECT_URI=
CONDUX_GOOGLE_CLIENT_ID=
CONDUX_GOOGLE_CLIENT_SECRET=
CONDUX_GOOGLE_REDIRECT_URI=
CONDUX_STRIPE_SECRET_KEY=
CONDUX_STRIPE_WEBHOOK_SECRET=
CONDUX_STRIPE_PRICE_TEAM=
CONDUX_STRIPE_PRICE_BUSINESS=
CONDUX_ANTHROPIC_API_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CONDUX_SEED_ADMIN_EMAIL=
CONDUX_SEED_ADMIN_PASSWORD=
