# Condux production edge. Caddy terminates TLS with automatic Let's Encrypt certificates and
# reverse-proxies to the compose services on the private network. Replace the two hostnames with
# yours, and set an email for ACME notifications.
#
# app.condux.ai serves the dashboard AND the control-plane API on ONE origin, so the session cookie and
# the Google OAuth callback stay first-party. Requests under /api and /openapi go to the control-plane;
# everything else to the Next.js dashboard. (The dashboard's own /api/boom dogfood route is superseded by
# this routing in prod, which is fine — it is a dev-only "throw an error" endpoint.)

{
	# ACME contact for expiry / issuance notices. Set to a real inbox.
	email ops@condux.ai

	# Per-request metrics, labelled by host. THIS is what records them, and it is the only thing that
	# does. `per_host` adds the host label: without it every series carries only Caddy's internal
	# server name (srv0, srv1), so a request rate cannot say which site it belongs to, and this edge
	# serves the dashboard and the relay from one process.
	#
	# DO NOT PUT A BARE `metrics` INSIDE A SITE BLOCK. It reads like "record this site" and it is not:
	# `metrics` is a terminal HANDLER that SERVES the Prometheus endpoint, and with no path matcher it
	# matches every request. Caddy's fixed directive order runs it before `reverse_proxy`, and its
	# ServeHTTP never calls the next handler, so the site answers metrics to everything and the proxy
	# behind it is unreachable. It answers 200 doing it, which is what an SDK reads as delivered.
	#
	# 200 is what makes this expensive rather than merely wrong: a site in that state accepts events
	# and discards them, and every check that reads a status code agrees that it is healthy.
	#
	# A site written with `handle` blocks does not show it, because `handle` is ordered ahead of
	# `metrics` and answers first. That is an accident of ordering and not a protection, so do not
	# read one working site as evidence that the other is fine. Measured against caddy:2-alpine, both
	# shapes, before and after.
	metrics {
		per_host
	}
}

app.condux.ai {
	encode zstd gzip

	@backend path /api/* /openapi/*
	handle @backend {
		reverse_proxy controlplane:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

# SDK / OTLP ingest — the stateless relay only. SDKs point their DSN host here; an OpenTelemetry exporter
# posts to ingest.condux.ai/api/<project-uuid>/v1/logs.
ingest.condux.ai {
	encode zstd gzip
	reverse_proxy relay:9000
}

# Prometheus metrics. NOT published to any host port: it is reachable only on the compose network, by
# the monitoring stack. The `metrics` directive serves the Prometheus endpoint at /metrics.
:2020 {
	metrics
}
