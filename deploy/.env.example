# Local-dev credentials for docker-compose (deploy/docker-compose.yml).
# Copy this to deploy/.env before starting the stack:
#   cp deploy/.env.example deploy/.env
# Then run compose with --env-file (the README has the one-command path):
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
#
# These are DEV-ONLY throwaway values — never used in production (prod supplies real
# secrets via its own environment / secrets manager). deploy/.env is gitignored, so
# no credentials — even dev ones — live in the compose source.
POSTGRES_USER=condux
POSTGRES_PASSWORD=condux
POSTGRES_DB=condux

CLICKHOUSE_USER=condux
CLICKHOUSE_PASSWORD=condux
CLICKHOUSE_DB=condux

MINIO_ROOT_USER=condux
MINIO_ROOT_PASSWORD=conduxsecret
# Source-map object store (ADR-0028). In dev the control-plane reuses the MinIO above (creds from
# MINIO_ROOT_*), and minio-init auto-creates this bucket, so source-map upload works out of the box.
# Override the bucket name if you like; endpoint/region default to MinIO in compose. Prod uses a BYO S3
# bucket via deploy/.env.prod (CONDUX_S3_ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY/REGION).
CONDUX_S3_BUCKET=condux-sourcemaps

# Dev-only admin account, seeded by the control-plane at startup so you can sign in immediately
# (owner of a personal org). Leave both UNSET in production — then nothing is seeded.
CONDUX_SEED_ADMIN_EMAIL=admin@condux.dev
CONDUX_SEED_ADMIN_PASSWORD=condux-dev-admin

# Platform super-admin allowlist (comma-separated emails) for the /admin operator console. Lists the
# seeded admin so a local sign-in can open /admin. Leave UNSET in production → no platform admins.
CONDUX_PLATFORM_ADMIN_EMAILS=admin@condux.dev

# Host + scheme the control-plane bakes into the DSNs / ingest URLs it hands to users. Dev points at the
# relay's host port so an SDK on your machine can reach it; leave unset to use that default. In PRODUCTION
# this MUST be the public relay host or every minted DSN points at localhost and no event can be ingested
# (docker-compose.prod.yml sets these to https + ingest.condux.ai).
# CONDUX_INGEST_SCHEME=http
# CONDUX_INGEST_HOST=localhost:9010

# Read-only "view as org" impersonation for the admin console (ADR-0027): the HMAC key that signs the
# impersonation cookie. OPT-IN — when unset, the view-as start/stop routes 404 and no one can be
# impersonated. Set to any long random string to enable it locally; leave UNSET until deliberately on.
CONDUX_IMPERSONATION_SIGNING_KEY=dev-impersonation-signing-key-change-me

# The AES-256 master key (base64, 32 bytes) that seals every secret we store but must be able to read
# back: BYO model keys, SSO client secrets, and TOTP secrets for two-factor authentication.
#
# SET THIS IN EVERY DEPLOYMENT. It began as an opt-in feature gate, but two-factor authentication now
# depends on it, and a security feature that is silently absent unless someone remembered an env var is
# a bad default. Without it the MFA panel says so by name rather than hiding, and the SSO and BYO-key
# routes 404.
#
# Generate one with:  openssl rand -base64 32
CONDUX_SECRET_KEY=ZGV2LW9ubHktY29uZHV4LW1hc3Rlci1rZXktMzJieXRlcw==

# Secret store master key for the BYO-key registry (#65) AND enterprise SSO (#72): the base64 AES-256 key
# that encrypts each org's LLM API key / SSO client secret at rest. OPT-IN — when unset, the
# /api/orgs/{id}/llm-config + /api/auth/sso/* + /api/orgs/{id}/sso-config routes 404 (no secret is ever
# stored without an encryption key). Generate one with: openssl rand -base64 32
# CONDUX_SECRET_KEY=

# Email delivery (#56 alerts + #130 org notices + #84 invite accept links). The dev stack bundles a Mailpit
# catcher and points the consumer + control-plane at it by default, so email works out of the box (read
# caught mail in the web inbox at http://localhost:8025). Slack + webhook need no config (each channel
# carries its own target URL). Uncomment + set these ONLY to override the dev default, e.g. a real SMTP relay
# in a self-host. SSL defaults to false for the plaintext Mailpit; set "true" for a TLS relay.
# CONDUX_SMTP_HOST=mailpit
# CONDUX_SMTP_PORT=1025
# CONDUX_SMTP_FROM=alerts@condux.dev
# CONDUX_SMTP_SSL=false
# CONDUX_SMTP_USER=
# CONDUX_SMTP_PASSWORD=
# Absolute base URL used for links inside emails (invite accept links), the enterprise-SSO OIDC redirect
# URI (#72), and the Stripe checkout/portal return URLs (Stripe rejects a relative URL). In split-origin
# dev it defaults to the first CONDUX_CORS_ORIGINS entry, so it can stay unset
# locally. In same-origin prod there is no CORS origin, so set it to the dashboard host (prod compose sets
# https://app.condux.ai). NOTE for local SSO testing: the SSO callback lives on the control-plane (:8080),
# not the web dev server (:3000), so set this to http://localhost:8080 while testing SSO locally.
# CONDUX_APP_BASE_URL=http://localhost:3000

# Dev GitHub webhook forwarding. Create a channel at https://smee.io/new and put it here; `pnpm dev` (and
# `pnpm dev:smee`) forward it to the local control-plane at /api/github/webhook. The same URL goes in
# the GitHub App's webhook field. Developer-specific, so it stays out of the compose source.
# WEBHOOK_PROXY_URL=https://smee.io/your-channel

# Conductor fix provider (#62). "fake" (default) fabricates a result with no LLM/PR; "simulated-agent" runs
# the full start->poll orchestration against a simulated backend so you can watch the dashboard fix panel go
# through RUNNING then SUCCEEDED locally (still no real LLM/PR); "anthropic" is the real thing — Claude
# proposes the fix from the scoped, scrubbed context and the Conductor opens a DRAFT PR via the GitHub App.
# "anthropic" requires CONDUX_ANTHROPIC_API_KEY plus the GitHub App credentials below (fails fast if
# missing). "managed-agents" (ADR-0038) runs platform-key fixes on Anthropic-hosted sessions instead of
# the in-process loop (BYO-key orgs stay in-process): same required env as "anthropic", plus optionally
# CONDUX_CMA_MAX_SESSION_USD (per-session hard budget, default 5), CONDUX_CMA_AGENT_ID /
# CONDUX_CMA_ENVIRONMENT_ID (pin vendor-side objects across restarts) and
# CONDUX_CONDUCTOR_POLL_SECONDS / CONDUX_CONDUCTOR_MAX_POLLS (poll cadence; managed-agents defaults to
# 10s x 240). Leave unset for "fake".
# CONDUX_CONDUCTOR_PROVIDER=anthropic
# CONDUX_ANTHROPIC_API_KEY=

# A dev-local self-hosted runner (ADR-0033; `pnpm dev:runner`, scripts/runner-dev.sh): the org runner
# token minted in Settings -> General -> Runner tokens. Dev convenience only — a real runner is deployed
# by the customer with their own credentials, never from this file.
# CONDUX_RUNNER_TOKEN=

# The agentic loop (ADR-0033), on the "anthropic" provider only. Off by default: a run makes the single
# ADR-0016 patch-proposal call, where the model sees a handful of scoped files and answers once. On, the
# model drives a bounded tool loop (list/read/write, then finish) so it can pull in a file nobody thought
# to scope and revise its own edit. It still cannot execute anything, and it still ends in a draft PR.
# Costs more tokens per run than the single-shot path, since every turn resends the conversation.
# CONDUX_CONDUCTOR_AGENTIC=true

# The sandbox the agent runs build, test and scanning commands in (ADR-0033 slice 2). Off unless an image
# is set: without one the agent can read and edit but not execute, and the command tool is not offered at
# all. The image must already be present on the daemon and should carry the toolchain of the repos you fix.
# CONDUX_SANDBOX_IMAGE=your-sandbox-image:tag
#
# Which daemon runs the containers. Unset means the local Docker socket. Point it at a separate host to
# keep the container runtime on different hardware from the rest of the deployment, which is worth doing
# wherever the containers would otherwise share a machine with your datastores.
# CONDUX_SANDBOX_DOCKER_ENDPOINT=tcp://sandbox-host:2376
#
# Per-container caps and the per-command timeout. Defaults: 2048 MB, 512 processes, 300 seconds.
# CONDUX_SANDBOX_MEMORY_MB=2048
# CONDUX_SANDBOX_PIDS=512
# CONDUX_SANDBOX_TIMEOUT_SECONDS=300

# GitHub App (the Conductor). Register one at github.com/settings/apps, then set these to enable the
# /api/github/* install flow (opt-in; unset → the routes stay off). App ID + Client ID are NOT secret; the
# webhook secret + private key ARE. Put those in deploy/.env, which is gitignored, never here: this file
# is tracked. Keep the .pem out of git too.
# For compose: the key is mounted read-only into the container at /run/secrets/github-app.pem. Point
# CONDUX_GITHUB_PRIVATE_KEY_HOST_PATH at your .pem, RELATIVE TO deploy/ (e.g. ../my-app.private-key.pem for
# a key in the repo root). CONDUX_GITHUB_PRIVATE_KEY_PATH defaults to the mounted container path.
# CONDUX_GITHUB_CLIENT_ID=
# CONDUX_GITHUB_WEBHOOK_SECRET=
# CONDUX_GITHUB_APP_SLUG=
# CONDUX_GITHUB_PRIVATE_KEY_HOST_PATH=../github-app.pem
# User authorization for connecting. Set both (or neither) to let an org connect through GitHub's OAuth
# leg, which is the only way to re-link an app that is already installed — the install URL stops
# redirecting back once it is. The client secret IS secret. The redirect URI must exactly match a
# Callback URL on the App, and points at the API (dev: the control-plane's own port, not the dashboard).
# CONDUX_GITHUB_CLIENT_SECRET=
# CONDUX_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/github/oauth/callback

# "Sign in with Google" (OIDC, #71). Opt-in: set all three to enable the /api/auth/oauth/google/* routes
# and the "Continue with Google" button (unset → off, and the button is hidden). Create an OAuth 2.0
# Client ID (type "Web application") in the Google Cloud console; the client secret IS secret, so it goes
# in deploy/.env, not here. The redirect URI must EXACTLY match the one registered there. The API's callback:
#   prod: https://app.condux.ai/api/auth/oauth/google/callback
#   split-origin dev: http://localhost:8080/api/auth/oauth/google/callback
# CONDUX_GOOGLE_CLIENT_ID=
# CONDUX_GOOGLE_CLIENT_SECRET=
# CONDUX_GOOGLE_REDIRECT_URI=

# Stripe billing (#billing). Opt-in: set all to enable the /api/orgs/{id}/billing/* + /api/stripe/webhook
# routes and the upgrade UI (unset => off). Use TEST keys in dev. Create two recurring Prices in the
# Stripe dashboard (Team, Business) and paste their price ids. Forward webhooks to the local control-plane
# with the Stripe CLI: `stripe listen --forward-to localhost:8080/api/stripe/webhook` (it prints the
# whsec_ signing secret to use). The secret key + webhook secret ARE secret, so put them in deploy/.env
# rather than here.
# CONDUX_STRIPE_SECRET_KEY=sk_test_...
# CONDUX_STRIPE_WEBHOOK_SECRET=whsec_...
# CONDUX_STRIPE_PRICE_TEAM=price_...
# CONDUX_STRIPE_PRICE_BUSINESS=price_...

# Condux on Condux: DSN the dashboard server reports its own errors to (empty = off). Provision a
# project in the dashboard and paste its DSN; use host relay:9000 for compose, localhost:9010 for
# a host-run dev:web.
CONDUX_WEB_DSN=

# The client half (#75, ADR-0028): the same key as CONDUX_WEB_DSN but with the PUBLIC relay host
# (http://<key>@localhost:9010/<uuid> in dev) — baked into the browser bundle, where relay:9000 means
# nothing. Browser events tunnel through the dashboard's /monitoring route either way. Empty = off.
CONDUX_WEB_PUBLIC_DSN=

# Condux on Condux (#75): DSN the .NET services (relay + control-plane) report their own errors to via the
# Condux .NET SDK (empty = off). Same idea as CONDUX_WEB_DSN, for the backend. Compose forwards it.
CONDUX_SELF_DSN=

# OpenTelemetry (#75): every backend service exports traces + metrics over OTLP when this points at a
# collector (e.g. an OTel Collector, Jaeger, Grafana Tempo). OPT-IN — unset (the default) means telemetry
# is off. Compose forwards it to the relay, control-plane, consumer and conductor.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
