  "type": "library",
  "keywords": ["error-monitoring", "condux", "sentry", "observability"],
  "license": "Apache-2.0",
  "homepage": "https://condux.ai",
  "authors": [
    {
      "name": "Condux",
      "homepage": "https://condux.ai"
    }
  ],
  "support": {
    "issues": "https://github.com/tripledownab/condux/issues",
    "source": "https://github.com/tripledownab/condux"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Condux\\": "src/"
    }
  },
  "scripts": {
    "test": "php test/run.php"
  }
