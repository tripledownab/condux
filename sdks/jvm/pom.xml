<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.condux</groupId>
  <artifactId>condux</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Condux SDK for the JVM</name>
  <description>Report errors to a Condux relay (Sentry store wire shape) with a resilient, never-throwing transport. Zero dependencies.</description>
  <url>https://condux.ai</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Condux</name>
      <organization>Condux</organization>
      <organizationUrl>https://condux.ai</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/tripledownab/condux.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/tripledownab/condux.git</developerConnection>
    <url>https://github.com/tripledownab/condux/tree/main/sdks/jvm</url>
  </scm>

  <!-- Publishing target: GitHub Packages Maven registry. The publish workflow supplies credentials via a
       generated settings.xml using the built-in GITHUB_TOKEN, and that token can only write packages to
       the repository the workflow runs in — so this URL must name that repository, not the public mirror,
       or the deploy is rejected. Note GitHub Packages requires a token to READ as well, so this is not a
       substitute for Maven Central: publishing there instead means swapping this repository and adding
       GPG signing. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/tripledownab/condux-private</url>
    </repository>
  </distributionManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Maven Central publishing, behind a profile so it changes nothing about an ordinary build.
       CI activates it with -Pcentral; `mvn package` and the plain-javac path stay exactly as they were.

       Why Central at all, when the artifact already publishes to GitHub Packages: that registry accepts
       ONLY classic personal access tokens, and the read:packages scope on one is account-wide. Every JVM
       consumer therefore had to mint a token granting read across every organisation they belong to,
       just to depend on us, while our other six registries resolve anonymously. Central removes that.

       Central's requirements, all satisfied here: sources and javadoc jars, PGP signatures on every
       file, and complete POM metadata (name, description, url, licence, developers, scm — above). PGP is
       still mandatory; Sonatype added Sigstore validation but were explicit that it supplements
       signatures rather than replacing them. -->
  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- Central requires a javadoc jar to exist, not to be lint-clean. Failing a release on a
                   missing @param would be a self-inflicted outage on the publish path. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- The passphrase arrives via env rather than an interactive prompt; without this the
                       plugin waits for a TTY that a runner does not have and the job hangs to timeout. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Upload and release in one step. The alternative leaves each release sitting in the
                   portal waiting for a human to press a button, which is exactly the manual step that
                   left the public mirror with no GitHub Releases for three versions. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <!-- Zero runtime dependencies: HTTP is java.net.http, JSON is written by hand. The one dependency is
       compile-only (provided): the servlet API the ConduxExceptionFilter (Spring Boot / servlet adapter)
       implements, supplied by the container at runtime. -->
  <dependencies>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- Spring is provided for the same reason the servlet API is: an app that registers
         ConduxExceptionResolver already has Spring on the classpath, and everyone else keeps an SDK with
         no runtime dependencies at all. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>6.1.14</version>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
